# Published host port (nginx on the host will proxy to 127.0.0.1:$PLACE_PORT later).
PLACE_PORT=8090
# 0.0.0.0 = reachable on http://132.145.101.159:8090 ; switch to 127.0.0.1 once nginx fronts it.
PLACE_BIND=0.0.0.0
# Host directory that holds redis/ and place/ subdirectories.
PLACE_DATA_DIR=./data
# uid:gid that owns the files written into PLACE_DATA_DIR. Must match the host user that
# owns that directory — check with `id -u` (`ubuntu` images are often 1000, sometimes 1001).
PLACE_UID=1000
PLACE_GID=1000
IMAGE_SIZE=250
RATE_LIMIT_SECONDS=5
# Comma-separated browser clientIds that bypass the cooldown (admin brush mode).
ADMIN_CLIENT_IDS=
